diff --git a/brain/tests/test_alert_minimal.py b/brain/tests/test_alert_minimal.py
new file mode 100644
index 0000000..cf8b78a
--- /dev/null
+++ b/brain/tests/test_alert_minimal.py
@@ -0,0 +1,43 @@
+"""Category A privacy patch (Abram, 19 Nov; SEC-09): the alert channel gets only that a message is waiting."""
+import json
+import logging
+
+from brain import notify
+
+
+class _Resp:
+    status = 200
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *a):
+        return False
+
+
+def test_the_alert_carries_no_message_contact_or_person(monkeypatch, caplog):
+    sent = []
+    monkeypatch.setattr(notify.urllib.request, "urlopen", lambda req, timeout: sent.append(req.data) or _Resp())
+    with caplog.at_level(logging.WARNING, logger="brain.safety"):
+        ok = notify.send_alert("https://hooks.example.invalid/x", 42, "user-abcdef123456",
+                               "I feel unsafe near the bridge", "07700 900123")
+    assert ok and len(sent) == 1
+    text = json.loads(sent[0])["text"]
+    assert text.startswith("ODYS Help & safety: message #42 is waiting (received ")
+    for private in ("I feel unsafe", "bridge", "07700", "900123", "user-abc", "abcdef"):
+        assert private not in text
+    logged = caplog.text
+    assert "I feel unsafe near the bridge" in logged          # as the privacy notice says
+    assert "07700" not in logged and "user-abcdef" not in logged
+
+
+def test_no_webhook_means_nothing_is_posted(monkeypatch):
+    monkeypatch.setattr(notify.urllib.request, "urlopen", lambda *a, **k: (_ for _ in ()).throw(AssertionError))
+    assert notify.send_alert(None, 1, "u", "m", "c") is False
+
+
+def test_a_failed_post_never_fails_the_request(monkeypatch):
+    def boom(*a, **k):
+        raise OSError("down")
+    monkeypatch.setattr(notify.urllib.request, "urlopen", boom)
+    assert notify.send_alert("https://hooks.example.invalid/x", 7, "u", "m") is False
