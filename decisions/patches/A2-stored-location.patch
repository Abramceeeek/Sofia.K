+# A2 (Abram, 19-20 Nov; SEC-06). The start point and the stay's name are sent by the app and processed to plan the
+# day, and the reply gives the person their own copy; neither is retained in the stored plan after the request.
+HERE_NAMES = {"where you are"}   # what both frozen apps send as the start's name for "Start from where I am"
+
+
+def kept_stops(stops: list[dict], *, drop_start_pin: bool = False, hide: str | None = None,
+               shown_as: str = "your stay") -> list[dict]:
+    """The copy of a plan's stops that is kept in the database.
+
+    - `drop_start_pin`: the day started from the person's own position. The notice says that point is "sent once,
+      rounded to about 100 metres ... and it isn't kept", but lunch near the start carried it as its map pin.
+    - `hide`: the name of the person's stay. The notice says a stay is kept by "its location, never its name"; the
+      first stop's "from …" and "Lunch near …" carried it. The kept copy says `shown_as` instead."""
+    def clean(v):
+        if isinstance(v, str):
+            return v.replace(hide, shown_as) if hide else v
+        if isinstance(v, list):
+            return [clean(x) for x in v]
+        if isinstance(v, dict):
+            return {k: clean(x) for k, x in v.items()}
+        return v
+
+    out = []
+    for st in stops:
+        st = clean(st) if hide else dict(st)
+        if drop_start_pin and str(st.get("moment_id", "")).endswith("@start"):
+            st["pin"] = None
+        out.append(st)
+    return out
+
+
